# EditorConfig: https://editorconfig.org
# Tells every editor to use the same baseline style. Black/ruff enforce
# the same on commit via pre-commit hooks.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.{md}]
# Markdown: keep trailing whitespace on lines that need a hard line break.
# Most of the time we don't, so trim.
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
